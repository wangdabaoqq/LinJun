{
  "name": "linjun",
  "version": "1.0.6-beta.11",
  "description": "霖君 - Cross-platform CLIProxyAPIPlus management tool",
  "main": "./out/main/index.js",
  "author": "wangdaboqq <wangdabao221@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangdabaoqq/LinJun.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mac": "bun run build && electron-builder --mac",
    "build:win": "bun run build && electron-builder --win",
    "build:linux": "bun run build && electron-builder --linux",
    "build:all": "bun run build && electron-builder --mac --win --linux",
    "release": "bun run build && electron-builder --publish always",
    "release:mac": "bun run build && electron-builder --mac --publish always",
    "release:win": "bun run build && electron-builder --win --publish always",
    "release:linux": "bun run build && electron-builder --linux --publish always",
    "release:all": "bun run build && electron-builder --mac --win --linux --publish always",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "download:binary": "ts-node scripts/download-binary.ts"
  },
  "dependencies": {
    "@lobehub/icons": "^4.0.3",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@tanstack/react-virtual": "^3.13.18",
    "axios": "^1.6.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.562.0",
    "motion": "^12.27.5",
    "tailwind-merge": "^3.4.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^1.0.0",
    "@electron-toolkit/tsconfig": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "33.4.11",
    "electron-builder": "^24.9.0",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.55.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
